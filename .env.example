# Copy this file to .env. Process environment variables override these values.
ELH_APP_TITLE=Expert Learning Hub Management System
ELH_ENVIRONMENT=development
ELH_DATABASE_PATH=elh_management.db
ELH_DATABASE_ENGINE=sqlite
ELH_DATABASE_HOST=localhost
ELH_DATABASE_PORT=3306
ELH_DATABASE_NAME=elhims
ELH_DATABASE_USER=root
ELH_DATABASE_PASSWORD=
ELH_BACKUP_DIRECTORY=backups
ELH_LOG_DIRECTORY=logs
ELH_LOG_LEVEL=INFO
ELH_LOG_MAX_BYTES=5000000
ELH_LOG_BACKUP_COUNT=5
ELH_SESSION_IDLE_MINUTES=20
# Optional explicit paths; leave blank to auto-detect standard MySQL installations.
ELH_MYSQL_DUMP_PATH=
ELH_MYSQL_CLIENT_PATH=

# Course completion certificates. Leave the template path blank to use the
# certificate bundled with the application. To customize the design, start
# from: templates/Certificate Template - Minimal Modern.docx
ELH_CERTIFICATE_TEMPLATE_PATH=
ELH_CERTIFICATE_OUTPUT_DIRECTORY=output/certificates
# Certificate numbering is configured under System Admin -> Application Settings.
# Optional blank A4-landscape PNG/JPEG used behind direct certificate PDF content.
ELH_CERTIFICATE_PDF_BACKGROUND_PATH=
# Instructor and principal defaults come from Course and Company Details.
ELH_DATE_FORMAT=%Y/%m/%d
# Currency is configured under System Admin -> Application Settings.
ELH_WINDOW_WIDTH=1420
ELH_WINDOW_HEIGHT=860
ELH_MIN_WINDOW_WIDTH=1100
ELH_MIN_WINDOW_HEIGHT=700
ELH_ALLOW_NEGATIVE_BALANCE=false
ELH_SEED_DEMO_DATA=false
ELH_HEALTH_STALE_BACKUP_HOURS=168

# Optional hardware. The application starts normally when these are disabled.
ELH_ATTENDANCE_DRIVER=disabled
ELH_ZKTECO_HOST=
ELH_ZKTECO_PORT=4370
ELH_ZKTECO_PASSWORD=0
ELH_ZKTECO_TIMEOUT_SECONDS=10
ELH_POS_PRINTER_DRIVER=disabled
ELH_POS_PRINTER_HOST=
ELH_POS_PRINTER_PORT=9100
ELH_POS_PRINTER_CHARS_PER_LINE=42

# SMS provider secrets remain environment-only. Enable a provider, sender ID,
# events, and message templates under System Admin -> SMS & Notifications.
ELH_AAKASH_SMS_TOKEN=
ELH_AAKASH_SMS_ENDPOINT=https://sms.aakashsms.com/sms/v3/send
ELH_SPARROW_SMS_TOKEN=
ELH_SPARROW_SMS_ENDPOINT=https://api.sparrowsms.com/v2/sms/

# Initial role accounts. Supply unique passwords before the first run.
ELH_OPERATOR_USERNAME=operator
ELH_OPERATOR_PASSWORD=
ELH_ADMIN_USERNAME=admin
ELH_ADMIN_PASSWORD=
ELH_MAINTENANCE_USERNAME=maintenance
ELH_MAINTENANCE_PASSWORD=

# =====================================================================
# ELH Management System - cPanel Web Hosting Configuration Template
# =====================================================================
# Copy this file to .env on your cPanel application root and update the
# values with your cPanel MySQL and organization settings.
# =====================================================================

ELH_APP_TITLE=Expert Learning Hub
ELH_ENVIRONMENT=production

# ---------------------------------------------------------------------
# cPanel MySQL Database Configuration
# In cPanel, the database host is typically "localhost".
# Database and username are usually prefixed with your cPanel account name.
# ---------------------------------------------------------------------
ELH_DATABASE_ENGINE=mysql
ELH_DATABASE_HOST=localhost
ELH_DATABASE_PORT=3306
ELH_DATABASE_NAME=cpaneluser_elhms
ELH_DATABASE_USER=cpaneluser_dbuser
ELH_DATABASE_PASSWORD=YourStrongDbPasswordHere

# ---------------------------------------------------------------------
# Device Configuration for Cloud Hosting
# NOTE: Because physical devices (biometric machine & POS printer) are on the
# institute's private local network (LAN), cPanel cannot reach them directly.
# 1. ATTENDANCE: Set to "disabled" on cPanel. The Institute Admin PC runs the
#    Device Sync Service to automatically push punch logs to cPanel.
# 2. POS PRINTER: Set to "cloud_spool". Print jobs will be queued in the database
#    and fetched by the Institute Admin PC for physical printing.
# ---------------------------------------------------------------------
ELH_ATTENDANCE_DRIVER=disabled
ELH_POS_PRINTER_DRIVER=cloud_spool

# ---------------------------------------------------------------------
# Security & Device Sync Authentication
# Set a strong random secret key.
# The ELH_SYNC_API_TOKEN is used by your Admin PC Device Gateway service
# to authenticate when syncing attendance and printing.
# ---------------------------------------------------------------------
ELH_SECRET_KEY=generate-a-secure-random-string-at-least-32-chars
ELH_SYNC_API_TOKEN=generate-a-secure-token-for-admin-pc-sync

# ---------------------------------------------------------------------
# Web Server & User Sessions
# ---------------------------------------------------------------------
ELH_WEB_HOST=0.0.0.0
ELH_WEB_PORT=8080
ELH_SESSION_IDLE_MINUTES=60
ELH_WEB_SESSION_EXPIRY_MINUTES=1440
ELH_USE_MODERN_WEB=1

# ---------------------------------------------------------------------
# Default Administrative Accounts (Initial Bootstrap)
# ---------------------------------------------------------------------
ELH_ADMIN_USERNAME=admin
ELH_ADMIN_PASSWORD=Admin@2025
ELH_OPERATOR_USERNAME=operator
ELH_OPERATOR_PASSWORD=Operator@2025
ELH_MAINTENANCE_USERNAME=maintenance
ELH_MAINTENANCE_PASSWORD=Maintenance@2025

# ---------------------------------------------------------------------
# SMS Gateways (Nepal Aakash SMS / Sparrow SMS)
# ---------------------------------------------------------------------
ELH_AAKASH_SMS_TOKEN=your_aakash_sms_token_here
ELH_AAKASH_SMS_ENDPOINT=https://sms.aakashsms.com/sms/v3/send
ELH_SPARROW_SMS_TOKEN=
ELH_SPARROW_SMS_ENDPOINT=https://api.sparrowsms.com/v2/sms/

# ---------------------------------------------------------------------
# WhatsApp Cloud API Integration
# ---------------------------------------------------------------------
ELH_WHATSAPP_ENABLED=true
ELH_WHATSAPP_PROVIDER=meta_cloud
ELH_WHATSAPP_COUNTRY_CODE=977
ELH_WHATSAPP_META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
ELH_WHATSAPP_META_ACCESS_TOKEN=your_meta_access_token_here

# ---------------------------------------------------------------------
# Google Gemini AI Integration
# ---------------------------------------------------------------------
ELH_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ELH_AI_PROVIDER=gemini
AI_PROVIDER=gemini
ELH_AI_MODEL=gemini-3.6-flash
AI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------
# Localization & Formats
# ---------------------------------------------------------------------
ELH_DATE_FORMAT=%Y/%m/%d
ELH_CURRENCY_SYMBOL=Rs.
ELH_ALLOW_NEGATIVE_BALANCE=True
ELH_SEED_DEMO_DATA=False
